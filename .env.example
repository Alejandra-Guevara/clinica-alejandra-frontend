PORT=3000
NODE_ENV=development
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=clinica_api
DB_PASSWORD=replace-with-a-unique-random-secret
DB_SSL=false
# Ruta al certificado CA si la instancia MySQL requiere una CA específica
DB_SSL_CA=
# Existing XAMPP database. The supplied SQL creates historias_clinicas in a fresh import.
DB_NAME=clinica-alejandra
FRONTEND_URL=http://localhost:5173
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
COOKIE_SECURE=false
TRUST_PROXY=0
